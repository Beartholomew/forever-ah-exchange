# Copy this file to settings.env and fill in your Blizzard API client.
# Create one free at https://develop.battle.net/access/clients
# Never share settings.env or paste the secret into chat.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
REGION=us
LOCALE=en_US

# Forever namespaces (undocumented). Leave STATIC_NAMESPACE blank to auto-detect;
# if detection fails, run the probe and paste the value it prints, e.g.
# STATIC_NAMESPACE=static-1.60.1_70399-forever-us
DYNAMIC_NAMESPACE=dynamic-forever-us
STATIC_NAMESPACE=
PROFILE_NAMESPACE=profile-forever-us
# Which Forever server type to collect: PvE, PvP, Hardcore or RP
RULESET_NAME=PvE
# Auction house the dashboard opens on (all houses in the ruleset are still collected)
DEFAULT_HOUSE=Alliance
# Auction house ids to collect, from: python -m ahtracker.find_house
HOUSE_IDS=

# AH cut per house. Confirm these in game and adjust.
AH_CUT_ALLIANCE=0.05
AH_CUT_HORDE=0.05
AH_CUT_BLACKWATER=0.15
# Deposit as a fraction of an item's vendor sell price (placeholder, confirm in game)
DEPOSIT_RATE=0.15
